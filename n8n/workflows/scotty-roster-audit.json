    {
      "id": "scotty-roster-audit",
      "name": "Check chief and specialist roster",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        790,
        260
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nif(r.ok!==true || r.mode!=='READ_ONLY' || !Array.isArray(r.agents)) throw new Error('Invalid SCOTTY catalog');\nif(r.agentCount!==185 || r.chiefCount!==25 || r.specialistCount!==160 || r.agents.length!==185) throw new Error('Staging roster count differs from draft roster');\nconst departments=[...new Set(r.agents.map(a=>a.department))].sort();\nreturn [{json:{mode:r.mode,liveRosterVerified:r.rosterVerifiedLive,agentCount:r.agentCount,chiefCount:r.chiefCount,specialistCount:r.specialistCount,departments,agents:r.agents.map(a=>({id:a.id,name:a.name,chiefId:a.chiefId,skills:a.skills}))}}];"
      }
    }
  ],
  "connections": {
