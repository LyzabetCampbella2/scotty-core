      ],
      "parameters": {
        "method": "GET",
        "url": "https://REPLACE-WITH-YOUR-STAGING-WORKER.workers.dev/api/n8n/catalog",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
