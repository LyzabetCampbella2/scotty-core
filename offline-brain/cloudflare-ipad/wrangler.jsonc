{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "scotty-independent-ipad-brain-lab",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_ENABLED": "true",
    "BRAIN_ENVIRONMENT": "ISOLATED_RESEARCH_ONLY"
  },
  "d1_databases": [
    {
      "binding": "BRAIN_DB",
      "database_name": "scotty-brain-memory",
      "database_id": "2da492e2-84fe-43a1-9afe-66b81300def1"
    }
  ]
}
